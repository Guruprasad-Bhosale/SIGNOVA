# Environment Configuration for SIGNOVA
# Copy to .env and customize as needed. Never commit .env to version control.

# Runtime
SIGNOVA_ENV=development
SIGNOVA_LOG_LEVEL=INFO
SIGNOVA_SEED=42
SIGNOVA_DEVICE=auto

# API Server
SIGNOVA_API_HOST=127.0.0.1
SIGNOVA_API_PORT=8000
SIGNOVA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# External Dataset Paths (Override if located outside default tree)
ISLTRANSLATE_ROOT=../ISLTranslate-main
INCLUDE_DATASET_ROOT=./data/raw/include
